#!/usr/bin/env bash
# vdots-read — read a Markdown file aloud (macOS `say`), headless.
#
# The in-editor experience (rendered preview pane, follow-along, pause/jump,
# media keys) lives in lua/vdots/readaloud/ and the `;r` keymaps. This is the
# CLI path: the same Markdown parse + tech-pronunciation + paced silences.
#
# Usage:
#   vdots-read [--voice V] [--tone warm|clarity] [--pace follow|relaxed|natural] [--rate N] FILE.md
#   vdots-read --export [...] FILE.md      render <FILE>.m4a and open it
#   vdots-read --publish [...] FILE.md     add to the listen library (vdots-listen)
#   vdots-read --dry-run FILE.md           print the spoken script, don't speak
#   vdots-read --sample [--voice V] [FILE] speak a short sample (audition a voice)
#   vdots-read --print-voice [--tone T]    print the auto-picked voice
#
# No --voice: the best installed voice for the tone is auto-picked. Siri voices
# ("Siri Voice 4") are not auto-detected — pass --voice "Siri Voice 4".
set -euo pipefail

# Mirrors lua/vdots/readaloud/config.lua voice_prefs. $1 = tone, $2 = lang.
auto_voice() {
  command -v say >/dev/null || return 0
  local have; have="$(say -v '?' 2>/dev/null)"
  local list v loc="${2:-en-US}"
  if [[ "$loc" != en-* && "$loc" != en_* ]]; then
    # non-English: first voice whose locale matches (say lists e.g. "es_MX")
    local tag="${loc//-/_}"
    v="$(grep -E "  ${tag} " <<<"$have" | head -1 | sed -E 's/  +[a-z]{2}_.*//; s/ +$//')"
    [[ -n "$v" ]] && { printf '%s' "$v"; return 0; }
  fi
  if [[ "${1:-warm}" == clarity ]]; then
    list=("Alex" "Ava (Enhanced)" "Evan (Enhanced)" "Samantha (Enhanced)" "Samantha" "Daniel")
  else
    list=("Zoe (Premium)" "Ava (Premium)" "Ava (Enhanced)" "Evan (Premium)" "Evan (Enhanced)" \
          "Joelle (Enhanced)" "Samantha (Enhanced)" "Sandy" "Flo" "Samantha" "Karen" "Moira")
  fi
  for v in "${list[@]}"; do
    grep -qF "$v " <<<"$have" && { printf '%s' "$v"; return 0; }
  done
}


HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VDOTS_REPO="$(dirname "$HERE")"
export VDOTS_REPO

voice="" ; rate="" ; mode="say" ; tone="warm" ; paceval="follow" ; file="" ; cues_dur="" ; lang="en-US"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --voice) voice="$2"; shift 2 ;;
    --rate)  rate="$2";  shift 2 ;;
    --tone)  tone="$2";  shift 2 ;;
    --pace)  paceval="$2"; shift 2 ;;
    --clarity) tone="clarity"; shift ;;
    --publish) mode="publish"; shift ;;
    --print-pace) mode="print-pace"; shift ;;
    --export) mode="export"; shift ;;
    --dry-run) mode="dry"; shift ;;
    --sample) mode="sample"; shift ;;
    --transcript) mode="transcript"; shift ;;
    --cues) mode="cues"; cues_dur="$2"; shift 2 ;;
    --cues-json) mode="cues-json"; cues_dur="$2"; shift 2 ;;
    --chapters) mode="chapters"; cues_dur="$2"; shift 2 ;;
    --chapters-vtt) mode="chapters-vtt"; cues_dur="$2"; shift 2 ;;
    --meta) mode="meta"; shift ;;
    --info) mode="info"; shift ;;
    --lang) lang="$2"; shift 2 ;;
    --print-voice) mode="print-voice"; shift ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "vdots-read: unknown option: $1" >&2; exit 1 ;;
    *) file="$1"; shift ;;
  esac
done

export VDOTS_PACE="$paceval"

if [[ "$mode" == print-pace ]]; then
  VDOTS_MODE=pace nvim --headless -u NONE -l "$HERE/vdots-read.lua" 2>/dev/null
  exit 0
fi

# the pace preset (rate + stretch), resolved once from pace.lua
rate_explicit=""; [[ -n "$rate" ]] && rate_explicit=1
eval "$(VDOTS_MODE=pace nvim --headless -u NONE -l "$HERE/vdots-read.lua" 2>/dev/null \
        | sed 's/^/pp_/')"   # -> $pp_rate $pp_stretch $pp_say_rate
[[ -n "$voice" ]] || voice="$(auto_voice "$tone" "$lang")"
# local `say` (no post-processing) folds the stretch into the rate; publish
# renders at the true rate and time-stretches the audio instead.
[[ -n "$rate" ]] || rate="${pp_say_rate:-155}"

if [[ "$mode" == print-voice ]]; then
  printf '%s\n' "$voice"; exit 0
fi

if [[ "$mode" == meta ]]; then
  [[ -n "$file" && -r "$file" ]] || { echo "{}"; exit 0; }
  VDOTS_MODE=meta nvim --headless -u NONE -l "$HERE/vdots-read.lua" "$file" 2>/dev/null
  exit 0
fi

if [[ "$mode" == info ]]; then
  [[ -n "$file" && -r "$file" ]] || { echo "vdots-read: cannot read: ${file:-<none>}" >&2; exit 1; }
  VDOTS_MODE=info VDOTS_PACE="$paceval" nvim --headless -u NONE -l "$HERE/vdots-read.lua" "$file" 2>/dev/null
  exit 0
fi

if [[ "$mode" == sample ]]; then
  command -v say >/dev/null || { echo "vdots-read: \`say\` not found" >&2; exit 1; }
  txt="This is a calm, [[slnc 75]] measured reading. [[slnc 300]] A beat at the commas, [[slnc 75]] a longer rest at the end of a sentence, [[slnc 300]] and then the next thought. [[slnc 360]] The whole thing is time-stretched afterward, [[slnc 75]] which is what leaves room to breathe between the words."
  [[ -n "$file" && -r "$file" ]] && txt="$(nvim --headless -u NONE -l "$HERE/vdots-read.lua" "$file" 2>/dev/null | head -c 800)"
  echo "vdots-read: sample — voice='${voice:-system default}' pace=$paceval rate=$rate (stretch ${pp_stretch:-?})"
  printf '%s\n' "$txt" | say -r "$rate" ${voice:+-v "$voice"}
  exit 0
fi

[[ -n "$file" ]] || { echo "vdots-read: no input file" >&2; exit 1; }

if [[ "$mode" == publish ]]; then
  # only forward --rate when the user set it; otherwise let vdots-listen apply
  # the pace preset (true rate + audio time-stretch) itself.
  exec "$HERE/vdots-listen" publish "$file" --tone "$tone" --pace "$paceval" \
    ${rate_explicit:+--rate "$rate"} ${voice:+--voice "$voice"}
fi

[[ -r "$file" ]] || { echo "vdots-read: cannot read: $file" >&2; exit 1; }
command -v nvim >/dev/null || { echo "vdots-read: nvim not found" >&2; exit 1; }

if [[ "$mode" == transcript ]]; then
  VDOTS_MODE=transcript nvim --headless -u NONE -l "$HERE/vdots-read.lua" "$file" 2>/dev/null
  exit 0
fi
if [[ "$mode" == cues ]]; then
  VDOTS_MODE=vtt VDOTS_DURATION="$cues_dur" nvim --headless -u NONE -l "$HERE/vdots-read.lua" "$file" 2>/dev/null
  exit 0
fi
if [[ "$mode" == cues-json ]]; then
  VDOTS_MODE=cues-json VDOTS_DURATION="$cues_dur" nvim --headless -u NONE -l "$HERE/vdots-read.lua" "$file" 2>/dev/null
  exit 0
fi
if [[ "$mode" == chapters ]]; then
  VDOTS_MODE=chapters VDOTS_DURATION="$cues_dur" nvim --headless -u NONE -l "$HERE/vdots-read.lua" "$file" 2>/dev/null
  exit 0
fi
if [[ "$mode" == chapters-vtt ]]; then
  VDOTS_MODE=chapters-vtt VDOTS_DURATION="$cues_dur" nvim --headless -u NONE -l "$HERE/vdots-read.lua" "$file" 2>/dev/null
  exit 0
fi

text="$(nvim --headless -u NONE -l "$HERE/vdots-read.lua" "$file" 2>/dev/null)"
[[ -n "$text" ]] || { echo "vdots-read: nothing to read in $file" >&2; exit 1; }

say_args=(-r "$rate")
[[ -n "$voice" ]] && say_args+=(-v "$voice")

case "$mode" in
  dry) printf '%s\n' "$text" ;;
  say)
    command -v say >/dev/null || { echo "vdots-read: \`say\` not found (macOS only)" >&2; exit 1; }
    printf '%s\n' "$text" | say "${say_args[@]}"
    ;;
  export)
    command -v say >/dev/null || { echo "vdots-read: \`say\` not found (macOS only)" >&2; exit 1; }
    out="${file%.*}.m4a"
    printf '%s\n' "$text" | say "${say_args[@]}" -o "$out"
    echo "vdots-read: wrote $out"
    command -v open >/dev/null && open "$out" || true
    ;;
esac
