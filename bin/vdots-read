#!/usr/bin/env bash
# vdots-read — read a Markdown file aloud (macOS `say`), headless.
#
# The in-editor experience (follow-along highlight, pause/resume, stop-on-edit)
# lives in lua/editor/readaloud.lua and the `;r` keymaps. This is the CLI path:
# same Markdown parse, piped to `say`.
#
# Usage:
#   vdots-read [--voice V] [--rate N] FILE.md      speak it
#   vdots-read --export [--voice V] [--rate N] FILE.md   render <FILE>.m4a and open it
#   vdots-read --dry-run FILE.md                   print the spoken text, don't speak
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VDOTS_REPO="$(dirname "$HERE")"
export VDOTS_REPO

voice="" ; rate="220" ; mode="say" ; file=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --voice) voice="$2"; shift 2 ;;
    --rate)  rate="$2";  shift 2 ;;
    --export) mode="export"; shift ;;
    --dry-run) mode="dry"; shift ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "vdots-read: unknown option: $1" >&2; exit 1 ;;
    *) file="$1"; shift ;;
  esac
done

[[ -n "$file" ]] || { echo "vdots-read: no input file" >&2; exit 1; }
[[ -r "$file" ]] || { echo "vdots-read: cannot read: $file" >&2; exit 1; }
command -v nvim >/dev/null || { echo "vdots-read: nvim not found" >&2; exit 1; }

text="$(nvim --headless -u NONE -l "$HERE/vdots-read.lua" "$file" 2>/dev/null)"
[[ -n "$text" ]] || { echo "vdots-read: nothing to read in $file" >&2; exit 1; }

say_args=(-r "$rate")
[[ -n "$voice" ]] && say_args+=(-v "$voice")

case "$mode" in
  dry) printf '%s\n' "$text" ;;
  say)
    command -v say >/dev/null || { echo "vdots-read: \`say\` not found (macOS only)" >&2; exit 1; }
    printf '%s\n' "$text" | say "${say_args[@]}"
    ;;
  export)
    command -v say >/dev/null || { echo "vdots-read: \`say\` not found (macOS only)" >&2; exit 1; }
    out="${file%.*}.m4a"
    printf '%s\n' "$text" | say "${say_args[@]}" -o "$out"
    echo "vdots-read: wrote $out"
    command -v open >/dev/null && open "$out" || true
    ;;
esac
