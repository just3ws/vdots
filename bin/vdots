#!/usr/bin/env bash
# vdots — Vdots (Neovim config) control plane. Thin dispatcher: vdots <noun> [args].
#
# Mirrors the platform convention (zdots <noun>, phx {…}, adots {sync|status|push}).
# Every noun resolves to a bin/vdots-<noun> script or a git verb on this repo.
#
# Nouns:
#   doctor            system health check ("brew doctor" for vdots)
#   ctl [check|update] runtime probe of the live Neovim config (:checkhealth)
#   update [opts]     update plugins (vim.pack), prune, test
#   read [opts] FILE  read a Markdown file aloud (macOS `say`)
#   sync              git pull --ff-only in ~/.config/nvim
#   status            git status --short
#   push [opts]       git push
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(dirname "$HERE")"

noun="${1:-doctor}"
shift || true

case "$noun" in
  doctor) exec "$HERE/vdots-doctor" "$@" ;;
  ctl)    exec "$HERE/vdots-ctl"    "$@" ;;
  update) exec "$HERE/vdots-update" "$@" ;;
  read)   exec "$HERE/vdots-read"   "$@" ;;
  sync)   exec git -C "$REPO" pull --ff-only "$@" ;;
  status) exec git -C "$REPO" status --short "$@" ;;
  push)   exec git -C "$REPO" push "$@" ;;
  -h|--help|help)
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    printf 'vdots: unknown noun "%s" (try: doctor ctl update read sync status push)\n' "$noun" >&2
    printf "run: vdots --help\n" >&2
    exit 1
    ;;
esac
