#!/usr/bin/env bash

# bin/vdots-ctl — Runtime health check for vdots.
# Deep probe of the live Neovim configuration via :checkhealth.
#
# Usage:
#   vdots-ctl check [--json]     Run the deep runtime healthcheck
#   vdots-ctl update [options]   Forward to vdots-update
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

run_healthcheck() {
    local health_file
    health_file="$(mktemp -t vdots-health.XXXXXX)"

    if ! nvim --headless "+checkhealth" "+w! $health_file" "+qall" >/dev/null 2>&1 \
        || [[ ! -s "$health_file" ]]; then
        printf '{"status": "fail", "warnings": 0, "errors": 1, "raw_file": "%s", "note": "nvim --headless +checkhealth produced no report"}\n' \
            "$health_file"
        return 0
    fi

    local warnings errors status
    warnings="$(grep -c "WARNING" "$health_file" || true)"
    errors="$(grep -c "ERROR" "$health_file" || true)"

    status="pass"
    if [[ "$errors" -gt 0 ]]; then status="fail";
    elif [[ "$warnings" -gt 0 ]]; then status="warn"; fi

    printf '{"status": "%s", "warnings": %d, "errors": %d, "raw_file": "%s"}\n' \
        "$status" "$warnings" "$errors" "$health_file"
}

check() {
    if [[ "${1:-}" == "--json" ]]; then
        run_healthcheck
        return
    fi

    echo "Running deep healthcheck..."
    local result warnings errors file
    result="$(run_healthcheck)"
    warnings="$(echo "$result" | jq .warnings)"
    errors="$(echo "$result" | jq .errors)"
    file="$(echo "$result" | jq -r .raw_file)"

    echo "Healthcheck results:"
    echo "  Errors:   $errors"
    echo "  Warnings: $warnings"
    echo "See full report: $file"
}

case "${1:-}" in
    check)  check "${@:2}" ;;
    update) exec "$SCRIPT_DIR/vdots-update" "${@:2}" ;;
    *)
        echo "Usage: vdots-ctl {check|update} [options]"
        echo "  check [--json]     Run deep runtime healthcheck"
        echo "  update [options]   Update plugins, prune unmanaged, and test"
        ;;
esac
