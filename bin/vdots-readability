#!/usr/bin/env python3
"""Readability report for prose on stdin. Emits JSON.

Standard formulas (Flesch Reading Ease, Flesch–Kincaid grade) with a common
vowel-group syllable heuristic. No dependencies.
"""
import json
import re
import sys

VOWELS = "aeiouy"


def syllables(word):
    w = re.sub(r"[^a-z]", "", word.lower())
    if not w:
        return 0
    count, prev_vowel = 0, False
    for ch in w:
        v = ch in VOWELS
        if v and not prev_vowel:
            count += 1
        prev_vowel = v
    if w.endswith("e") and count > 1:
        count -= 1
    return max(count, 1)


def band(score):
    for lo, label in [
        (90, "very easy"), (80, "easy"), (70, "fairly easy"), (60, "standard"),
        (50, "fairly difficult"), (30, "difficult"),
    ]:
        if score >= lo:
            return label
    return "very confusing"


def main():
    text = sys.stdin.read()
    sentences = [s for s in re.split(r"(?<=[.!?])\s+|\n{2,}", text.strip()) if s.strip()]
    words = re.findall(r"[A-Za-z][A-Za-z'-]*", text)
    n_sent = max(len(sentences), 1)
    n_word = max(len(words), 1)
    n_syl = sum(syllables(w) for w in words)
    poly = sum(1 for w in words if syllables(w) >= 3)

    wps = n_word / n_sent
    spw = n_syl / n_word
    flesch = 206.835 - 1.015 * wps - 84.6 * spw
    fk_grade = 0.39 * wps + 11.8 * spw - 15.59

    hard = sorted(
        ({"words": len(re.findall(r"[A-Za-z']+", s)), "text": s.strip()[:160]} for s in sentences),
        key=lambda d: d["words"], reverse=True,
    )[:3]

    out = {
        "words": len(words),
        "sentences": len(sentences),
        "syllables": n_syl,
        "polysyllabic_words": poly,
        "avg_words_per_sentence": round(wps, 1),
        "avg_syllables_per_word": round(spw, 2),
        "flesch_reading_ease": round(flesch, 1),
        "reading_ease_band": band(flesch),
        "flesch_kincaid_grade": round(fk_grade, 1),
        "reading_time_min": round(len(words) / 200, 1),      # silent reading
        "listening_time_min": round(len(words) / 155, 1),    # ~follow pace
        "longest_sentences": hard,
    }
    json.dump(out, sys.stdout, indent=2)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
