#!/usr/bin/env bash

# bin/vdots-doctor — System health check ("brew doctor" for vdots).
# Exits 0 when no failures are found; exits 1 on any [FAIL].
#
# Usage: vdots-doctor [--json] [--fix]
#   --fix   build the read-aloud media-key helper and install the SwiftBar shim
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(dirname "$SCRIPT_DIR")"

JSON_MODE=false
FIX=false
for arg in "$@"; do
    case "$arg" in
        --json) JSON_MODE=true ;;
        --fix)  FIX=true ;;
        -h|--help)
            sed -n '3,7p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
    esac
done

RUNTIME_CHECK="$("$SCRIPT_DIR/vdots-ctl" check --json)"
STATUS="$(echo "$RUNTIME_CHECK" | jq -r .status)"
WARNINGS="$(echo "$RUNTIME_CHECK" | jq .warnings)"
ERRORS="$(echo "$RUNTIME_CHECK" | jq .errors)"

EXIT_CODE=0
[[ "$STATUS" == "fail" ]] && EXIT_CODE=1

# ── read-aloud subsystem ────────────────────────────────────────────────────
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/vdots"
HELPER_SRC="$REPO/bin/vdots-mediakey-helper.swift"
HELPER_BIN="$CACHE/vdots-mediakey-helper"
SWIFTBAR_SHIM="$HOME/.swiftbar/vdots-readaloud.5s.sh"
ra_say=missing ra_swiftc=missing ra_helper=missing ra_swiftbar=absent

command -v say >/dev/null && ra_say=ok
ra_stretch=atempo
command -v rubberband >/dev/null && ra_stretch=rubberband
command -v ffmpeg >/dev/null || ra_stretch=none
ra_video=no
{ command -v rsvg-convert && command -v ffmpeg && command -v python3; } >/dev/null 2>&1 && ra_video=yes
ra_guide=no
{ command -v rsvg-convert && command -v python3; } >/dev/null 2>&1 && ra_guide=yes
if command -v swiftc >/dev/null; then
    ra_swiftc=ok
    if [[ "$FIX" == true || ! -x "$HELPER_BIN" || "$HELPER_SRC" -nt "$HELPER_BIN" ]]; then
        mkdir -p "$CACHE"
        if swiftc -O -o "$HELPER_BIN" "$HELPER_SRC" 2>/dev/null; then ra_helper=built; else ra_helper=build-failed; fi
    else
        ra_helper=ok
    fi
fi
[[ -r "$SWIFTBAR_SHIM" ]] && ra_swiftbar=installed
if [[ "$FIX" == true && "$ra_swiftbar" == absent ]]; then
    mkdir -p "$HOME/.swiftbar"
    printf '#!/usr/bin/env bash\nexec "%s/bin/vdots-readaloud-swiftbar"\n' "$REPO" > "$SWIFTBAR_SHIM"
    chmod +x "$SWIFTBAR_SHIM"
    ra_swiftbar=installed
fi

LISTEN_DIR="${VDOTS_LISTEN_DIR:-$HOME/ai/outbox/listen}"
ra_listen="not-created"
[[ -d "$LISTEN_DIR" ]] && ra_listen="ok ($LISTEN_DIR)"
[[ "$FIX" == true && ! -d "$LISTEN_DIR" ]] && { mkdir -p "$LISTEN_DIR" && ra_listen="created ($LISTEN_DIR)"; }
ra_drive="not-detected"
[[ -d "$HOME/ai/.tmp.driveupload" || -d "$HOME/Library/CloudStorage" ]] && ra_drive="Google Drive desktop present"

if [[ "$JSON_MODE" == true ]]; then
    cat <<EOF
{
  "status": "$STATUS",
  "checks": { "warnings": $WARNINGS, "failures": $ERRORS },
  "readaloud": {
    "say": "$ra_say", "swiftc": "$ra_swiftc",
    "media_key_helper": "$ra_helper", "swiftbar_shim": "$ra_swiftbar",
    "listen_library": "$ra_listen", "drive_sync": "$ra_drive",
    "pace_stretch": "$ra_stretch",
    "readalong_video": "$ra_video",
    "guide_pdf": "$ra_guide"
  },
  "runtime": $(echo "$RUNTIME_CHECK" | jq -c .)
}
EOF
else
    echo "━━━ vdots Health ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [[ "$ERRORS" -gt 0 ]]; then
        echo "  [FAIL] Neovim runtime diagnostics found $ERRORS error(s)."
    elif [[ "$WARNINGS" -gt 0 ]]; then
        echo "  [warn] Neovim runtime diagnostics: $WARNINGS warning(s)."
    else
        echo "  [ok]   Neovim runtime diagnostics healthy."
    fi
    echo ""
    echo "  read-aloud:"
    printf '    %-18s %s\n' "say"              "$ra_say"
    printf '    %-18s %s\n' "pace stretch"     "$ra_stretch"
    printf '    %-18s %s\n' "readalong video"  "$ra_video"
    printf '    %-18s %s\n' "guide pdf"        "$ra_guide"
    printf '    %-18s %s\n' "swiftc"           "$ra_swiftc"
    printf '    %-18s %s\n' "media-key helper" "$ra_helper"
    printf '    %-18s %s\n' "SwiftBar shim"    "$ra_swiftbar"
    printf '    %-18s %s\n' "listen library"   "$ra_listen"
    printf '    %-18s %s\n' "Drive sync"       "$ra_drive"
    [[ "$ra_swiftbar" == absent ]] && echo "    (run 'vdots doctor --fix' to install the SwiftBar remote + listen library)"
    echo ""
    "$SCRIPT_DIR/vdots-ctl" check
fi

exit $EXIT_CODE
